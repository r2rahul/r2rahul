{
  "sandbox": {
    "enabled": false
  },
  "permission": {
    "skill": {
      "self-knowledge": "allow"
    }
  },
  "mcpServers": {
    "io.github.github/github-mcp-server": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "gallery": "https://api.mcp.github.com",
      "version": "0.30.3"
    },
    "microsoft/playwright-mcp": {
      "type": "stdio",
      "command": "/usr/bin/npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "gallery": "https://api.mcp.github.com",
      "version": "0.0.1-seed"
    },
    "Agent Skills": {
      "url": "https://agentskills.io/mcp",
      "type": "http"
    },
    "repomix": {
      "command": "/usr/bin/npx",
      "args": [
        "-y",
        "repomix",
        "--mcp"
      ],
      "type": "stdio"
    },
    "microsoft/markitdown": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "markitdown-mcp@0.0.1a4"
      ],
      "gallery": "https://api.mcp.github.com",
      "version": "1.0.0"
    },
    "io.github.upstash/context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@upstash/context7-mcp@1.0.31"
      ],
      "env": {
        "CONTEXT7_API_KEY": "ctx7sk-5a7b2be2-5e3c-4ef1-a188-743d61d71171"
      },
      "gallery": "https://api.mcp.github.com",
      "version": "1.0.31"
    },
    "mcp-obsidian": {
      "command": "uvx",
      "args": [
        "mcp-obsidian"
      ],
      "env": {
        "OBSIDIAN_API_KEY": "e3475ae6d5e1e1dc9a555ac1a899cdbce902ac4fb683f6ab102cd7aeefc86450",
        "OBSIDIAN_HOST": "127.0.0.1",
        "OBSIDIAN_PORT": "27124"
      }
    }
  }
}
